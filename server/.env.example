PORT=4000

APP_TIMEZONE=Asia/Kolkata

DEFAULT_AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback provider: ollama | gemini | groq
AI_FALLBACK_PROVIDER=

MAX_RESULT_DOCUMENTS=100
MAX_SAMPLE_DOCUMENTS=10
MAX_PIPELINE_STAGES=30
QUERY_TIMEOUT_MS=15000

# Used by npm run seed:test (local MongoDB by default)
MONGODB_URI=mongodb://127.0.0.1:27017
TEST_DATABASE_NAME=test_shop_db

# Optional path for saved connections + settings (default: server/data/app-store.json)
# APP_STORE_PATH=

# QuickBooks Online (sandbox). Redirect URI must match Intuit Developer → Settings exactly.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:4000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_FRONTEND_REDIRECT=http://localhost:5173/connections

# Microsoft 365 / Outlook (Entra app registration). Redirect URI must match Entra exactly.
# Use common for work/school + personal Microsoft accounts.
# Use organizations for work/school only (blocks outlook.com / hotmail personal accounts).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_FRONTEND_REDIRECT=http://localhost:5173/connections

# SMTP for Triggers / alert emails (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
