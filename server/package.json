{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude ./data --exclude ./data/** src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --ext .ts",
    "test": "vitest run",
    "test:e2e": "tsx src/scripts/e2e.ts",
    "seed:test": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.29.0",
    "intuit-oauth": "^4.2.5",
    "mongodb": "^6.18.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.24.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "pino": "^9.9.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.33.0",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
